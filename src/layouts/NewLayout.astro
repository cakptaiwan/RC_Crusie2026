{lcpImage && <link rel="preload" as="image" href={lcpImage} imagesrcset={lcpImageSrcset} imagesizes={lcpImageSrcset ? lcpImageSizes : undefined} type="image/webp" fetchpriority="high" />}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700;800;900&family=Noto+Serif+TC:wght@700;900&display=swap" media="print" onload="this.media='all'">
