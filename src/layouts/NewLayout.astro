---
import { getNavBrandMenus, journalSection } from '../data/brand-nav';
import { getAllPosts } from '../lib/notion';
import { newHomeUrl } from '../lib/new-article-url';
import { socialLinks } from '../data/social-links';
import ContactPanel from '../components/ContactPanel.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SEO from '../components/SEO.astro';
import '../styles/typography.css';

export interface Props {
  title: string;
  description?: string;
  navActive?: string;
  image?: string;
  type?: 'website' | 'article';
  jsonLd?: Record<string, unknown>;
  noindex?: boolean;
  breadcrumb?: Array<{ name: string; url: string }>;
  /** 首頁 LCP 圖 preload（WebP） */
  lcpImage?: string;
  /** 首頁 LCP 預載用的 imagesrcset／imagesizes，需與頁面 <picture> 的 webp <source> 一致 */
  lcpImageSrcset?: string;
  lcpImageSizes?: string;
  /** 頂部列移除下緣邊線，與緊接的 Hero 背景無縫相接（僅首頁使用） */
  headerSeamless?: boolean;
}

const { title, description, navActive = '', image, type = 'website', jsonLd, noindex = false, breadcrumb, lcpImage, lcpImageSrcset, lcpImageSizes, headerSeamless = false } = Astro.props;
/** 頂部選單／頁尾：品牌分區與其可見分類（文章數 ≥ 該分區 minArticles） */
const navMenus = getNavBrandMenus(await getAllPosts());
/** 頂部列「贊助」按鈕旗標：true 才渲染（連結 /donate） */
const SHOW_DONATE = false;
/** 目前所在分區：由網址判斷（/guide/、/royal/、/princess/ 及其底下頁面），或沿用頁面傳入的 navActive */
const { pathname } = Astro.url;
const activeSectionKey =
  navMenus.find((menu) => pathname === menu.href.replace(/\/$/, '') || pathname.startsWith(menu.href))?.section.key ?? '';
const isActiveSection = (key: string) => key === activeSectionKey || key === navActive;
---
<!DOCTYPE html>
<html lang="zh-Hant">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<SEO title={title} description={description ?? ''} image={image} type={type} jsonLd={jsonLd} noindex={noindex} breadcrumb={breadcrumb} />
<!-- Google Analytics -->
{import.meta.env.PUBLIC_GA_ID && (
  <>
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${import.meta.env.PUBLIC_GA_ID}`}></script>
    <script define:vars={{ gaId: import.meta.env.PUBLIC_GA_ID }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', gaId);
    </script>
  </>
)}
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
