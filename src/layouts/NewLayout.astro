.nav-burger{display:none;flex-direction:column;justify-content:center;gap:5px;width:36px;height:36px;padding:6px;cursor:pointer;border:1px solid rgba(11,42,74,.25);border-radius:8px;background:transparent}
.nav-burger span{display:block;height:2px;background:#0B2A4A;border-radius:1px;transition:transform .25s}
.nav-mobile{position:fixed;top:0;left:0;bottom:0;width:50%;max-width:320px;box-sizing:border-box;background:#fff;box-shadow:4px 0 24px rgba(11,42,74,.18);padding:76px 20px 20px;z-index:30;overflow-y:auto;transform:translateX(-100%);transition:transform .32s ease}
.nav-scrim{display:none;position:fixed;inset:0;background:rgba(11,42,74,.35);z-index:29;border:0;padding:0;margin:0;cursor:pointer}
.nav-m-sec{padding:14px 0;border-bottom:1px solid rgba(11,42,74,.1)}
.nav-m-sec:last-child{border-bottom:none}
.nav-m-hd{font-size:15px;font-weight:700;color:#3E6C97;margin-bottom:8px}
.nav-m-link{display:block;padding:9px 0 9px 14px;font-size:15px;font-weight:400;color:#33506B;text-decoration:none}
.nav-m-link:hover{color:#0B2A4A}
.nav-search{display:flex;align-items:center;margin:0}
.nav-search-in{box-sizing:border-box;width:168px;min-width:0;height:34px;padding:0 10px;border:1px solid rgba(11,42,74,.25);border-right:0;border-radius:8px 0 0 8px;background:#fff;color:#0B2A4A;font:inherit;font-size:14px;-webkit-appearance:none;appearance:none}
.nav-search-in::placeholder{color:#8AA3B9}
.nav-search-in:focus-visible,.nav-search-btn:focus-visible{outline:2px solid #3E6C97;outline-offset:1px}
.nav-search-btn{box-sizing:border-box;flex:none;display:flex;align-items:center;justify-content:center;width:36px;height:34px;padding:0;border:1px solid rgba(11,42,74,.25);border-radius:0 8px 8px 0;background:#0B2A4A;color:#fff;cursor:pointer}
.nav-search-m{display:none;margin:0 0 6px}
.nav-search-m .nav-search-in{flex:1;width:auto}
.nav-donate{display:inline-flex;align-items:center;height:34px;padding:0 14px;border-radius:8px;background:#0B2A4A;color:#fff;font-size:14px;font-weight:700;text-decoration:none;white-space:nowrap}
.nav-donate-m{display:flex;justify-content:center;margin-top:14px}
.nl.navon::after{height:3px}
.nl[aria-current]{font-weight:700}
@media (max-width:1200px){
.a-links,.nav-search-d,.nav-donate-d{display:none}
.nav-burger{display:flex}
.nav-search-m{display:flex}
.nav-toggle:checked~.nav-mobile{transform:translateX(0)}
.nav-toggle:checked~.nav-scrim{display:block}
.nav-toggle:checked+.brand+.a-links+.fx .nav-burger span:nth-child(1){transform:translateY(7px) rotate(45deg)}
.nav-toggle:checked+.brand+.a-links+.fx .nav-burger span:nth-child(2){opacity:0}
.nav-toggle:checked+.brand+.a-links+.fx .nav-burger span:nth-child(3){transform:translateY(-7px) rotate(-45deg)}
}
/* 首頁與列表的方框卡片（數值同 brand/BrandPostCard）；a.pcard 提高權重，蓋過 .a-row／.t-cell／.l-row 的分隔線與內距 */
a.pcard{background:#fff;border:1px solid rgba(11,42,74,.16);border-radius:16px;padding:20px;box-sizing:border-box;min-width:0}
a.pcard:hover{background:rgba(11,42,74,.04);opacity:1}
a.a-row.pcard+a.a-row.pcard{margin-top:16px}
.pcard-grid{row-gap:16px}
.crumb-title,.ah1,.a-h3,.l-t,.a-rt{overflow-wrap:anywhere;word-break:break-word}
.crumb{flex-wrap:wrap}
@media (max-width:900px){
html,body{overflow-x:hidden}
.a-nav{padding:16px 24px;flex-wrap:wrap}
.a-links{display:none}
.nav-burger{display:flex}
.nav-toggle:checked~.nav-mobile{transform:translateX(0)}
.nav-toggle:checked~.nav-scrim{display:block}
.nav-toggle:checked+.brand+.a-links+.fx .nav-burger span:nth-child(1){transform:translateY(7px) rotate(45deg)}
.nav-toggle:checked+.brand+.a-links+.fx .nav-burger span:nth-child(2){opacity:0}
.nav-toggle:checked+.brand+.a-links+.fx .nav-burger span:nth-child(3){transform:translateY(-7px) rotate(-45deg)}
.main2{grid-template-columns:1fr;gap:32px;padding:0 24px 64px}
.c-hero{margin:0!important}
.c-hero .tband{padding:0!important;border-radius:0!important;background:transparent!important}
.hero-boarding-pass{width:100%;border-radius:0;box-shadow:none}
.crumb{padding:16px 24px 0}
.ah{padding:16px 24px 0}
.ah1{font-size:26px;line-height:1.4}
.aheroimg{margin:20px auto 0;padding:0 24px;max-width:100%}
.abody{padding:24px 24px 48px;max-width:100%;overflow-x:auto;-webkit-overflow-scrolling:touch}
.a-h2{font-size:30px}
.a-h3{font-size:22px}
.bh2{font-size:21px;margin:36px 0 16px}
.a-head{margin-bottom:32px;flex-wrap:wrap;gap:12px}
.sec-head{margin:48px 0 28px;flex-wrap:wrap;gap:12px}
.a-grid,.t-grid,.l-grid{grid-template-columns:1fr}
.t-lead{grid-template-columns:1fr;gap:24px}
.a-sec{padding:48px 0 64px}
.a-sec .a-head{padding:0 24px}
.a-sec .a-grid>.rev.rev-r{padding:0 24px;box-sizing:border-box}
.a-lead{display:grid;grid-template-columns:1fr;gap:24px}
.a-sec .lead-body{padding:0 16px;width:auto;max-width:100%}
.a-leadimg,.t-leadimg{width:100vw;max-width:100vw;margin-left:calc(50% - 50vw);margin-right:calc(50% - 50vw)}
.pcard .a-leadimg,.pcard .t-leadimg{width:auto;max-width:100%;margin-left:0;margin-right:0}
.a-sec .a-grid>.a-lead.pcard{margin:0 24px}
.a-sec .pcard .lead-body{padding:0}
.lead-body{min-width:0;width:100%;box-sizing:border-box}
.t-leadimg{min-width:0}
.t-cell{grid-template-columns:1fr 96px;gap:14px;min-width:0}
.t-thumb{width:96px;aspect-ratio:3/2;height:auto;flex-shrink:0}
.a-row{grid-template-columns:36px 1fr 96px;gap:12px;padding:18px 0;min-width:0}
.a-thumb{width:96px;aspect-ratio:3/2;height:auto;flex-shrink:0}
.l-row{grid-template-columns:96px 1fr;gap:14px;min-width:0}
.l-thumb{width:96px;aspect-ratio:3/2;height:auto;flex-shrink:0}
.tband{padding:16px;border-radius:18px}
.ticket{flex-direction:column}
.tmain .tkhd{border-radius:16px 16px 0 0;padding:12px 16px;font-size:11px;letter-spacing:.16em}
.tkhd2{border-radius:0;padding:12px 16px}
.tbody{padding:16px 16px 12px}
.tship{width:68%;right:-16px;bottom:-8px}
.bph1{font-size:28px!important;line-height:1.35;margin:14px 0 18px!important}
.coderow{flex-wrap:wrap;gap:12px!important}
.tin .coderow{gap:12px!important}
.route{flex-wrap:wrap;gap:10px!important;max-width:100%!important}
.route .rc{font-size:18px!important}
.rc{font-size:18px!important}
.tfoot{flex-wrap:wrap;gap:12px;padding:12px 16px 16px}
.tfoot .coderow{gap:14px!important}
.tfoot .bar{width:100%!important;max-width:180px}
.tstub{display:none}
.snotch{display:none}
.tsbody{padding:16px}
.abody .tbl{display:table;max-width:none;margin:0}
.abody .tbl-scroll{margin:20px 0}
.kbox{padding:18px 20px;margin:8px 0 24px}
.tocbox{margin:0 0 24px}
.toch{padding:14px 16px}
.toclist{padding:0 16px 14px 16px}
.tip{padding:2px 0 2px 18px;margin:16px 0}
.abody p:has(+ .tip){margin-bottom:16px}
.authbox{flex-direction:column;gap:16px;padding:20px 22px}
.nowrap{white-space:normal}
}
@media (max-width:600px){
a.pcard{padding:14px}
}
.nav-soc-m{display:none}
.a-nav.a-nav-seamless{border-bottom:0}
@media (max-width:640px){
.a-nav{flex-wrap:nowrap}
.nav-soc-top{display:none}
.nav-soc-m{display:flex;gap:12px;padding:10px 0 14px}
}
.fab-frap {
  position: fixed;
  bottom: 1.5rem;
  right: 1.5rem;
  z-index: 50;
  display: flex;
  height: 3.5rem;
  width: 3.5rem;
  align-items: center;
  justify-content: center;
  border-radius: 9999px;
  background-color: #0073BB;
  color: #ffffff;
  box-shadow:
    0 0 6px rgba(0, 0, 0, 0.24),
    0 8px 12px rgba(0, 0, 0, 0.14);
  transition:
    transform 0.35s cubic-bezier(0.22, 1, 0.36, 1),
    box-shadow 0.35s ease,
    background-color 0.2s ease;
}
.fab-frap svg {
  width: 32px;
  height: 32px;
}
.fab-frap:hover {
  transform: translateY(-2px);
  box-shadow:
    0 4px 16px rgba(0, 115, 187, 0.35),
    0 12px 24px rgba(6, 21, 86, 0.18);
  background-color: #061556;
}
.fab-frap:active {
  transform: scale(0.95);
  box-shadow:
    0 0 6px rgba(0, 0, 0, 0.24),
    0 8px 12px rgba(0, 0, 0, 0);
}
</style>
</head>
<body>
<svg style="position:absolute;width:0;height:0" aria-hidden="true"><defs>
<symbol id="ic-ig" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" fill="none" stroke-width="1.6"></rect><circle cx="12" cy="12" r="4.2" stroke="currentColor" fill="none" stroke-width="1.6"></circle><circle cx="17.3" cy="6.7" r="1.1" fill="currentColor"></circle></symbol>
<symbol id="ic-fb" viewBox="0 0 24 24"><path d="M14 21v-8h2.5l.5-3H14V8.2c0-.9.3-1.5 1.6-1.5H17V4.1C16.6 4 15.7 4 14.7 4 12.5 4 11 5.3 11 7.8V10H8.5v3H11v8h3z" fill="currentColor"></path></symbol>
<symbol id="ic-yt" viewBox="0 0 24 24"><rect x="2.5" y="5" width="19" height="14" rx="4" stroke="currentColor" fill="none" stroke-width="1.6"></rect><path d="M10.3 9.3v5.4l4.9-2.7-4.9-2.7z" fill="currentColor"></path></symbol>
<symbol id="ic-th" viewBox="1.7 1.7 20.6 20.6"><path d="M18.2 8.9C17.4 6.2 15.2 4.7 12.2 4.7 8.3 4.7 5.9 7.5 5.9 12s2.4 7.3 6.3 7.3c2.8 0 4.8-1.4 4.8-3.7 0-2.2-1.9-3.4-4.2-3.4-1.8 0-2.9.8-2.9 1.9s1 1.9 2.4 1.9c2.1 0 3.1-1.6 3.1-4v-.8c0-1.8-1.2-2.8-3.1-2.8-1 0-1.8.3-2.3.9" stroke="currentColor" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></symbol>
</defs></svg>
<div class="art">
<nav class:list={['a-nav', headerSeamless && 'a-nav-seamless']}>
<input type="checkbox" id="nav-toggle" class="nav-toggle" aria-hidden="true">
<a href={newHomeUrl} class="brand" style="text-decoration:none;color:inherit"><img class="logo" src="/icon-192.png" alt="郵輪旅人 Cruise Traveler" width="42" height="42" data-lcp /><div class="wm wm-stack srf"><span class="wm1">郵輪旅人</span><span class="wm2">CRUISE TRAVELER</span></div></a>
<div class="a-links">
{
  navMenus.map((menu) => (
    <div class="nav-item">
      <a href={menu.href} class:list={['nl', isActiveSection(menu.section.key) && 'navon']} aria-current={isActiveSection(menu.section.key) ? 'true' : undefined} style="color:inherit;text-decoration:none;opacity:1">{menu.section.label}</a>
      {menu.categories.length > 0 && (
        <div class="nav-drop">
          {menu.categories.map((category) => (
            <a href={category.href}>{category.label}</a>
          ))}
        </div>
      )}
    </div>
  ))
}
<div class="nav-item">
  <span class:list={['nl', isActiveSection(journalSection.key) && 'navon']} aria-current={isActiveSection(journalSection.key) ? 'true' : undefined}>{journalSection.label}</span>
  <div class="nav-drop">
    {journalSection.items.map((item) => (
      <a href={item.href}>{item.label}</a>
    ))}
  </div>
</div>
</div>
<div class="fx ac gap10">
<form class="nav-search nav-search-d" method="get" action="/search" role="search">
<input type="search" name="q" class="nav-search-in" aria-label="搜尋文章" placeholder="搜尋文章" autocomplete="off">
<button type="submit" class="nav-search-btn" aria-label="送出搜尋"><svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5" stroke="currentColor" fill="none" stroke-width="1.8"></circle><path d="M16 16l4.5 4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path></svg></button>
</form>
{SHOW_DONATE && <a class="nav-donate nav-donate-d" href="/donate">贊助</a>}
<label for="nav-toggle" class="nav-burger" aria-label="開啟導覽選單">
<span></span><span></span><span></span>
</label>
{socialLinks.map((link) => (
<a href={link.href} class="soc nav-soc-top" target="_blank" rel="noopener noreferrer" aria-label={link.label} style="text-decoration:none">
<svg width="15" height="15" viewBox="0 0 24 24"><use href={`#ic-${link.icon}`}></use></svg>
</a>
))}
</div>
<div class="nav-mobile">
<form class="nav-search nav-search-m" method="get" action="/search" role="search">
<input type="search" name="q" class="nav-search-in" aria-label="搜尋文章" placeholder="搜尋文章" autocomplete="off">
<button type="submit" class="nav-search-btn" aria-label="送出搜尋"><svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5" stroke="currentColor" fill="none" stroke-width="1.8"></circle><path d="M16 16l4.5 4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path></svg></button>
</form>
<div class="nav-soc-m">
{socialLinks.map((link) => (
<a href={link.href} class="soc" target="_blank" rel="noopener noreferrer" aria-label={link.label} style="text-decoration:none">
<svg width="15" height="15" viewBox="0 0 24 24"><use href={`#ic-${link.icon}`}></use></svg>
</a>
))}
</div>
{SHOW_DONATE && <a class="nav-donate nav-donate-m" href="/donate">贊助</a>}
{
  navMenus.map((menu) => (
    <div class="nav-m-sec">
      <a class="nav-m-hd" href={menu.href} style="display:block;text-decoration:none">{menu.section.label}</a>
      {menu.categories.map((category) => (
        <a class="nav-m-link" href={category.href}>{category.label}</a>
      ))}
    </div>
  ))
}
<div class="nav-m-sec">
  <div class="nav-m-hd">{journalSection.label}</div>
  {journalSection.items.map((item) => (
    <a class="nav-m-link" href={item.href}>{item.label}</a>
  ))}
</div>
</div>
<label for="nav-toggle" class="nav-scrim" aria-hidden="true"></label>
</nav>
<slot />
<ContactPanel />
<SiteFooter />
</div>
<a href="mailto:service@royal-cruiser.com" class="fab-frap" aria-label="快速聯絡 service@royal-cruiser.com">
  <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
    <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
  </svg>
</a>
<script src="/reveal/reveal-animation.js" defer></script>
</body>
</html>
