---
import NewLayout from '../../layouts/NewLayout.astro';
import NewArticleView from '../../components/NewArticleView.astro';
import { categoryEntries, getCategoryHrefBySubPage } from '../../data/new-layout-nav';
import { getAllPosts, getPostById } from '../../lib/notion';
import { absoluteSiteUrl } from '../../lib/seo/site-url';
import { buildArticleJsonLd } from '../../lib/seo/jsonld';
import { postImage } from '../../lib/cloudinary-image';

export async function getStaticPaths() {
  const posts = await getAllPosts();
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { id } = Astro.params;
const { post: staticPost } = Astro.props;
const post = staticPost ?? (await getPostById(id!));

if (!post) {
  return Astro.redirect('/');
}

const navEntry = categoryEntries.find(
  (e) => e.subPage === post.subPage || e.subPage === post.category,
);

const categoryHref = getCategoryHrefBySubPage(post.subPage || post.category);
const displayTitle = post.title.trim();
const breadcrumbItems = [
  { name: '首頁', url: absoluteSiteUrl('/') },
  { name: post.subPage || post.category, url: absoluteSiteUrl(categoryHref) },
  { name: displayTitle, url: absoluteSiteUrl(`/post/${post.id}/`) },
];

const articleJsonLd = buildArticleJsonLd(post);
const ogImage = post.image ? postImage(post.image, 'hero') : undefined;
---

<NewLayout
  title={post.title}
  description={post.excerpt}
  navActive={navEntry?.navActiveKey ?? ''}
  image={ogImage}
  type="article"
  jsonLd={articleJsonLd}
  breadcrumb={breadcrumbItems}
>
  <NewArticleView post={post} />
</NewLayout>
