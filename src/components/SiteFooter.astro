---
/**
 * 全站頁尾（置中）：品牌區 → 四組選單 → 分隔線 → 版權與固定頁連結。
 * 選單資料與頂部列同源（brand-nav.ts 的 getNavBrandMenus、journalSection），不寫死。
 * 樣式自包含（scoped），NewLayout 與 BaseLayout 共用；BaseLayout 沒有社群圖示 sprite，傳 sprite 才在頁尾內補上。
 */
import { getNavBrandMenus, journalSection } from '../data/brand-nav';
import { getAllPosts } from '../lib/notion';
import { socialLinks } from '../data/social-links';

interface Props {
  /** 頁面本身沒有 #ic-* 社群圖示 sprite 時為 true */
  sprite?: boolean;
}

const { sprite = false } = Astro.props;
const navMenus = getNavBrandMenus(await getAllPosts());
const currentYear = new Date().getFullYear();

const groups = [
  ...navMenus.map((menu) => ({
    label: menu.section.label,
    href: menu.href as string | null,
    links: menu.categories.map(({ label, href }) => ({ label, href })),
  })),
  {
    label: journalSection.label,
    href: null as string | null,
    links: journalSection.items.map(({ label, href }) => ({ label, href })),
  },
];

const legalLinks = [
  { href: '/about/', label: '關於我們' },
  { href: '/privacy/', label: '隱私權政策' },
  { href: '/terms/', label: '使用條款' },
];
---

<footer class="sf rev">
  {sprite && (
    <svg style="position:absolute;width:0;height:0" aria-hidden="true">
      <defs>
        <symbol id="ic-ig" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" fill="none" stroke-width="1.6"></rect><circle cx="12" cy="12" r="4.2" stroke="currentColor" fill="none" stroke-width="1.6"></circle><circle cx="17.3" cy="6.7" r="1.1" fill="currentColor"></circle></symbol>
        <symbol id="ic-fb" viewBox="0 0 24 24"><path d="M14 21v-8h2.5l.5-3H14V8.2c0-.9.3-1.5 1.6-1.5H17V4.1C16.6 4 15.7 4 14.7 4 12.5 4 11 5.3 11 7.8V10H8.5v3H11v8h3z" fill="currentColor"></path></symbol>
        <symbol id="ic-yt" viewBox="0 0 24 24"><rect x="2.5" y="5" width="19" height="14" rx="4" stroke="currentColor" fill="none" stroke-width="1.6"></rect><path d="M10.3 9.3v5.4l4.9-2.7-4.9-2.7z" fill="currentColor"></path></symbol>
        <symbol id="ic-th" viewBox="1.7 1.7 20.6 20.6"><path d="M18.2 8.9C17.4 6.2 15.2 4.7 12.2 4.7 8.3 4.7 5.9 7.5 5.9 12s2.4 7.3 6.3 7.3c2.8 0 4.8-1.4 4.8-3.7 0-2.2-1.9-3.4-4.2-3.4-1.8 0-2.9.8-2.9 1.9s1 1.9 2.4 1.9c2.1 0 3.1-1.6 3.1-4v-.8c0-1.8-1.2-2.8-3.1-2.8-1 0-1.8.3-2.3.9" stroke="currentColor" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></symbol>
      </defs>
    </svg>
  )}
  <div class="sf-in">
    <div class="sf-top">
    <div class="sf-brand">
      <img class="sf-logo" src="/icon-192.png" alt="郵輪旅人 Cruise Traveler" width="56" height="56" loading="lazy" />
      <div class="sf-name">
        <span class="sf-n1">郵輪旅人</span>
        <span class="sf-n2">CRUISE TRAVELER</span>
      </div>
      <p class="sf-ex">全方位的郵輪知識中文網站</p>
      <div class="sf-soc">
        {socialLinks.map((link) => (
          <a href={link.href} target="_blank" rel="noopener noreferrer" aria-label={link.label}>
            <svg width="15" height="15" viewBox="0 0 24 24"><use href={`#ic-${link.icon}`}></use></svg>
          </a>
        ))}
      </div>
    </div>

    {[groups.slice(0, 2), groups.slice(2)].map((side, index) => (
      <div class:list={['sf-side', index === 0 ? 'sf-left' : 'sf-right']}>
        {side.map((group) => (
          <div class="sf-grp">
            <h3 class="sf-h">
              {group.href ? <a href={group.href}>{group.label}</a> : group.label}
            </h3>
            {group.links.map((link) => (
              <a class="sf-l" href={link.href}>{link.label}</a>
            ))}
          </div>
        ))}
      </div>
    ))}
    </div>

    <div class="sf-bar">
      <span>© {currentYear} 郵輪旅人 Cruise Traveler · All Rights Reserved</span>
      <span class="sf-legal">
        {legalLinks.map((link) => (
          <a href={link.href}>{link.label}</a>
        ))}
      </span>
    </div>
  </div>
</footer>

<style>
  .sf {
    background: #0B2A4A;
    color: #fff;
    padding: 64px 56px 0;
    text-align: center;
    font-family: 'Noto Sans TC', sans-serif;
    box-sizing: border-box;
  }
  .sf-in {
    max-width: 90rem;
    margin: 0 auto;
  }
  /* 641–1200px：品牌區在上、四組一列置中（左右區以 display:contents 讓四組直接排進 .sf-top） */
  .sf-top {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 32px 48px;
  }
  .sf-brand {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex: 0 0 100%;
    margin-bottom: 16px;
  }
  .sf-side {
    display: contents;
  }
  .sf-logo {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    display: block;
  }
  .sf-name {
    margin-top: 14px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    line-height: 1.1;
  }
  .sf-n1 {
    font-size: 22px;
    font-weight: 900;
    letter-spacing: .06em;
  }
  .sf-n2 {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: .28em;
    opacity: .75;
  }
  .sf-ex {
    margin: 12px 0 0;
    font-size: 13px;
    line-height: 1.7;
    color: rgba(255, 255, 255, .8);
  }
  .sf-soc {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin-top: 16px;
  }
  .sf-soc a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    box-sizing: border-box;
    border: 1px solid rgba(255, 255, 255, .55);
    border-radius: 50%;
    color: #fff;
    text-decoration: none;
  }
  .sf-grp {
    min-width: 0;
  }
  .sf-h {
    font-size: 14px;
    font-weight: 700;
    letter-spacing: .12em;
    margin: 0 0 16px;
    color: #fff;
  }
  .sf-h a {
    color: inherit;
    text-decoration: none;
  }
  .sf-l {
    display: block;
    padding: 6px 0;
    font-size: 13px;
    color: rgba(255, 255, 255, .7);
    text-decoration: none;
    transition: color .25s;
  }
  .sf-l:hover {
    color: #fff;
    opacity: 1;
  }
  .sf-bar {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    margin-top: 56px;
    padding: 22px 0 28px;
    border-top: 1px solid rgba(255, 255, 255, .18);
    font-size: 12px;
    color: rgba(255, 255, 255, .6);
  }
  .sf-legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px 24px;
  }
  .sf-legal a {
    color: rgba(255, 255, 255, .7);
    text-decoration: none;
    transition: color .25s;
  }
  .sf-legal a:hover {
    color: #fff;
    opacity: 1;
  }
  /* ≥1201px：品牌區在中央欄，前兩組靠左、後兩組靠右 */
  @media (min-width: 1201px) {
    .sf-top {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      column-gap: clamp(48px, 5vw, 88px);
      align-items: start;
    }
    .sf-brand {
      grid-column: 2;
      grid-row: 1;
      flex: none;
      margin-bottom: 0;
    }
    .sf-side {
      display: flex;
      grid-row: 1;
      gap: 56px;
    }
    .sf-left {
      grid-column: 1;
      justify-content: flex-end;
    }
    .sf-right {
      grid-column: 3;
      justify-content: flex-start;
    }
  }
  @media (max-width: 900px) {
    .sf {
      padding: 48px 24px 0;
    }
  }
  @media (max-width: 640px) {
    .sf {
      padding-bottom: 88px;
    }
    /* 四組 2×2：品牌區（含社群圖示）獨佔第一列，四組在其正下方；DOM 順序不變 */
    .sf-top {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 24px;
      row-gap: 32px;
      align-items: start;
      justify-items: center;
    }
    .sf-brand {
      grid-column: 1 / -1;
      flex: none;
      margin-bottom: 4px;
    }
    .sf-grp {
      width: 100%;
    }
    .sf-h {
      margin-bottom: 8px;
    }
    .sf-l {
      padding: 7px 0;
    }
    .sf-bar {
      margin-top: 36px;
    }
  }
  /* 極窄寬度改回單欄 */
  @media (max-width: 340px) {
    .sf-top {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
