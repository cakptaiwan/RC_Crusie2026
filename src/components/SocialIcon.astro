---
/**
 * 社群圖示（線條版，Tabler Icons 風格，stroke 1.25）。顏色吃 currentColor，裝飾用 aria-hidden；
 * 連結的 aria-label 由 SocialLink 負責。platform：ig／fb／th（對應 social-links.ts 的 icon 欄位）。
 */
interface Props {
  platform: 'ig' | 'fb' | 'th';
  /** 顯示邊長（px） */
  size?: number;
}

const { platform, size = 20 } = Astro.props;

const paths: Record<Props['platform'], string[]> = {
  fb: ['M7 10v4h3v7h4v-7h3l1 -4h-4v-2a1 1 0 0 1 1 -1h3v-4h-3a5 5 0 0 0 -5 5v2h-3'],
  ig: [
    'M3 7a4 4 0 0 1 4 -4h10a4 4 0 0 1 4 4v10a4 4 0 0 1 -4 4h-10a4 4 0 0 1 -4 -4l0 -10',
    'M8.5 12a3.5 3.5 0 1 0 7 0a3.5 3.5 0 0 0 -7 0',
    'M17 7v.01',
  ],
  th: [
    'M19 7.5c-1.333 -3 -3.667 -4.5 -7 -4.5c-5 0 -8 2.5 -8 9s3.5 9 8 9s7 -3 7 -5s-1 -5 -7 -5c-2.5 0 -3 1.25 -3 2.5c0 1.5 1 2.5 2.5 2.5c2.5 0 3.5 -1.5 3.5 -5s-2 -4 -3 -4s-1.833 .333 -2.5 1',
  ],
};
---

<svg
  class="soc-ico"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.25"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {paths[platform].map((d) => <path d={d} />)}
</svg>
