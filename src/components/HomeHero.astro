---
/**
 * 首頁 Hero（白底版）：左欄文字（小字、標語、簡介）；右側紙雕插畫靠右滿版、底緣貼齊 Hero 底部；左欄底部延伸海浪帶（桌機）。
 * 動態（海鷗＋海浪）只在 window load 後、閒置時才載入；減少動態、省流量、無 JS 或無 WebGL 時維持靜態圖，且不請求動態資源。
 * 圖檔在 public/assets/hero/（hero-w-*）；舊的 hero-banner 系列已不使用，檔案保留。
 */
// ── 文字（集中在這裡，方便修改）──────────────────────────────
const EYEBROW = '郵輪旅人 · CRUISE TRAVELER';
const TITLE = '陪你準備每一趟旅程';
// 標語打字效果（參照 React Bits TextType 預設值）
const TYPING_SPEED = 90;
const DELETING_SPEED = 40;
const PAUSE_DURATION = 2000;
const INTRO =
  '有感於中文郵輪資訊的稀缺，「郵輪旅人」是第一個以郵輪研究為主題的中文網站，分享國內外論壇與部落格的郵輪知識與心得資訊。';
// ─────────────────────────────────────────────────────────
---

<section class="hh">
  <img class="hh-base" src="/assets/hero/hero-base-wave-w.svg" alt="" aria-hidden="true" width="1560" height="187" loading="lazy" decoding="async" />
  <div class="hh-in">
    <div class="hh-txt">
      <div class="ovl">{EYEBROW}</div>
      <h1 class="hh-h1 srf">
        <span class="hh-sr">{TITLE}</span>
        <span
          class="hh-type"
          aria-hidden="true"
          data-typing={TYPING_SPEED}
          data-deleting={DELETING_SPEED}
          data-pause={PAUSE_DURATION}
        >
          <span class="hh-type-ghost" data-text={TITLE}></span>
          <span class="hh-type-live"><span class="hh-type-t"></span><span class="hh-cursor">|</span></span>
        </span>
      </h1>
      <script is:inline>
        // 打字效果：無 JS 或偏好減少動態時不執行，直接顯示完整句子（.hh-type-ghost 的 ::before）
        (function () {
          var h1 = document.currentScript.previousElementSibling;
          var root = h1 && h1.querySelector('.hh-type');
          if (!root) return;
          if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
          var full = Array.from(root.querySelector('.hh-type-ghost').getAttribute('data-text'));
          var out = root.querySelector('.hh-type-t');
          var typing = Number(root.dataset.typing);
          var deleting = Number(root.dataset.deleting);
          var pause = Number(root.dataset.pause);
          var n = 0;
          var erasing = false;
          root.classList.add('is-typing');
          function tick() {
            var wait;
            if (!erasing) {
              n += 1;
              out.textContent = full.slice(0, n).join('');
              if (n === full.length) { erasing = true; wait = pause; } else { wait = typing; }
            } else {
              n -= 1;
              out.textContent = full.slice(0, n).join('');
              if (n === 0) { erasing = false; wait = 400; } else { wait = deleting; }
            }
            setTimeout(tick, wait);
          }
          setTimeout(tick, typing);
        })();
      </script>
      <p class="hh-intro">{INTRO}</p>
    </div>
    <div class="hh-img" id="hh-stage">
      <div class="hh-layer">
        <picture>
          <source
            srcset="/assets/hero/hero-w-640.webp 640w, /assets/hero/hero-w-960.webp 960w, /assets/hero/hero-w-1280.webp 1280w, /assets/hero/hero-w-1536.webp 1536w"
            sizes="(min-width: 901px) min(54vw, 960px), 100vw"
            type="image/webp"
          />
          <img
            class="hh-pic"
            src="/assets/hero/hero-w-1536.jpg"
            alt="紙雕風格插畫：郵輪航行於藍色海浪與島嶼之間，海鷗飛過天空"
            width="1536"
            height="1024"
            loading="eager"
            decoding="async"
            fetchpriority="high"
            data-lcp
          />
        </picture>
        <canvas class="hh-fx" aria-hidden="true"></canvas>
        <div class="hh-birds" aria-hidden="true">
          <div class="hh-bird b1" style="width:5.794%"><img data-src="/assets/hero/hero-bird-1w.png" alt="" aria-hidden="true" width="89" height="44" loading="lazy" /></div>
          <div class="hh-bird b2" style="width:4.362%"><img data-src="/assets/hero/hero-bird-2w.png" alt="" aria-hidden="true" width="67" height="39" loading="lazy" /></div>
          <div class="hh-bird b3" style="width:5.339%"><img data-src="/assets/hero/hero-bird-3w.png" alt="" aria-hidden="true" width="82" height="48" loading="lazy" /></div>
        </div>
      </div>
    </div>
  </div>
</section>
<script is:inline>
  // Hero 動態（海鷗＋海浪）：預設不啟動。僅在非減少動態、非省流量、WebGL 可用時，於 window load 後閒置時載入資源；
  // 資源與 WebGL 都就緒才淡入（.is-live）。任何錯誤靜默退回靜態圖。參數為 A 版。
  (function () {
    try {
      var stage = document.getElementById('hh-stage');
      if (!stage) return;
      if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      var conn = navigator.connection;
      if (conn && conn.saveData === true) return;
      var AMP_Y = 10, AMP_X = 3, PERIOD = 8, WAVELEN = 260, X_WAVE_Y = 90, PHASE_MAX = 4.5, LEFT_RAMP = 0.12, MAX_FPS = 30;
      var A = '/assets/hero/';
      var canvas = stage.querySelector('.hh-fx');
      var fail = function () { stage.classList.remove('is-live'); running = false; };
      var running = false;
      function go() {
        try {
          var gl = canvas.getContext('webgl', { alpha: false, antialias: false, premultipliedAlpha: false });
          if (!gl) return;
          var vs = 'attribute vec2 p;varying vec2 uv;void main(){uv=p*.5+.5;uv.y=1.-uv.y;gl_Position=vec4(p,0.,1.);}';
          var fs = 'precision highp float;varying vec2 uv;uniform sampler2D img,msk,phs;' +
            'uniform float t,ampy,ampx,period,wavelen,xwave,phmax,ramp;const vec2 SZ=vec2(1536.,1024.);' +
            'void main(){vec2 px=uv*SZ;float m=texture2D(msk,uv).r;float ph=texture2D(phs,uv).r*phmax;' +
            'float k=m*m*(3.-2.*m)*(ramp>0.?clamp(px.x/(ramp*SZ.x),0.,1.):1.);float w=6.2831853*t/period;' +
            'float dy=ampy*k*sin(w+6.2831853*px.x/wavelen+ph);float dx=ampx*k*sin(w+px.y/xwave+ph);' +
            'vec2 s=clamp((px+vec2(dx,dy))/SZ,0.,1.);float ms=texture2D(msk,s).r;' +
            'gl_FragColor=vec4(mix(texture2D(img,uv).rgb,texture2D(img,s).rgb,m*ms),1.);}';
          var sh = function (type, code) {
            var o = gl.createShader(type); gl.shaderSource(o, code); gl.compileShader(o);
            if (!gl.getShaderParameter(o, gl.COMPILE_STATUS)) throw new Error('shader');
            return o;
          };
          var pr = gl.createProgram();
          gl.attachShader(pr, sh(gl.VERTEX_SHADER, vs)); gl.attachShader(pr, sh(gl.FRAGMENT_SHADER, fs));
          gl.linkProgram(pr);
          if (!gl.getProgramParameter(pr, gl.LINK_STATUS)) throw new Error('link');
          gl.useProgram(pr);
          gl.bindBuffer(gl.ARRAY_BUFFER, gl.createBuffer());
          gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]), gl.STATIC_DRAW);
          var loc = gl.getAttribLocation(pr, 'p'); gl.enableVertexAttribArray(loc); gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);
          var U = function (n) { return gl.getUniformLocation(pr, n); };
          gl.uniform1f(U('ampy'), AMP_Y); gl.uniform1f(U('ampx'), AMP_X); gl.uniform1f(U('period'), PERIOD);
          gl.uniform1f(U('wavelen'), WAVELEN); gl.uniform1f(U('xwave'), X_WAVE_Y); gl.uniform1f(U('phmax'), PHASE_MAX);
          var desk = window.matchMedia('(min-width: 901px)');
          var setRamp = function () { gl.uniform1f(U('ramp'), desk.matches ? LEFT_RAMP : 0); };
          setRamp();
          if (desk.addEventListener) desk.addEventListener('change', setRamp);
          var load = function (src) {
            return new Promise(function (ok, ng) { var i = new Image(); i.onload = function () { ok(i); }; i.onerror = ng; i.src = src; });
          };
          var birds = Array.prototype.slice.call(stage.querySelectorAll('.hh-bird img'));
          var birdLoads = birds.map(function (b) {
            return new Promise(function (ok, ng) { b.onload = ok; b.onerror = ng; b.src = b.getAttribute('data-src'); });
          });
          var tex = function (im, unit) {
            gl.activeTexture(gl.TEXTURE0 + unit); gl.bindTexture(gl.TEXTURE_2D, gl.createTexture());
            gl.pixelStorei(gl.UNPACK_COLORSPACE_CONVERSION_WEBGL, gl.NONE);
            gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, gl.RGBA, gl.UNSIGNED_BYTE, im);
            gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR); gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);
            gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE); gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
          };
          canvas.addEventListener('webglcontextlost', function (e) { e.preventDefault(); fail(); });
          Promise.all([load(A + 'hero-bg-nobirds-w.webp'), load(A + 'hero-wave-mask-w.png'), load(A + 'hero-phase-w.webp')].concat(birdLoads)).then(function (r) {
            tex(r[0], 0); tex(r[1], 1); tex(r[2], 2);
            gl.uniform1i(U('img'), 0); gl.uniform1i(U('msk'), 1); gl.uniform1i(U('phs'), 2);
            var fit = function () {
              var b = canvas.getBoundingClientRect(), k = Math.min(window.devicePixelRatio || 1, 1.5);
              var w = Math.max(1, Math.round(b.width * k)), h = Math.max(1, Math.round(b.height * k));
              if (canvas.width !== w || canvas.height !== h) { canvas.width = w; canvas.height = h; gl.viewport(0, 0, w, h); }
            };
            fit();
            window.addEventListener('resize', fit);
            var ut = U('t'), t0 = performance.now(), last = 0, inView = true, raf = 0;
            var frame = function (now) {
              raf = 0;
              if (!running) return;
              if (now - last >= 1000 / MAX_FPS - 2) {
                last = now;
                try { gl.uniform1f(ut, (now - t0) / 1000); gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4); } catch (e) { fail(); return; }
              }
              raf = requestAnimationFrame(frame);
            };
            var resume = function () {
              running = !document.hidden && inView && stage.classList.contains('is-live');
              if (running && !raf) raf = requestAnimationFrame(frame);
            };
            document.addEventListener('visibilitychange', resume);
            if ('IntersectionObserver' in window) {
              new IntersectionObserver(function (es) { inView = es[0].isIntersecting; resume(); }).observe(stage);
            }
            gl.uniform1f(ut, 0); gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);
            stage.classList.add('is-live');
            resume();
          }).catch(fail);
        } catch (e) {
          fail();
        }
      }
      var schedule = function () {
        if ('requestIdleCallback' in window) window.requestIdleCallback(go, { timeout: 3000 });
        else setTimeout(go, 1000);
      };
      if (document.readyState === 'complete') schedule();
      else window.addEventListener('load', schedule);
    } catch (e) {}
  })();
</script>

<style>
  .hh {
    background: #fff;
    color: #0B2A4A;
    padding: 56px 56px 48px;
    box-sizing: border-box;
  }
  .hh-in {
    max-width: 90rem;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 52fr) minmax(0, 48fr);
    gap: 48px;
    align-items: center;
  }
  .hh-txt {
    min-width: 0;
  }
  .hh-h1 {
    font-size: clamp(2.25rem, 3.4vw, 3.25rem);
    line-height: 1.25;
    font-weight: 900;
    letter-spacing: .01em;
    margin: 14px 0 0;
    color: #0B2A4A;
    overflow-wrap: anywhere;
  }
  .hh-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  /* 打字效果：ghost 與 live 疊在同一格，ghost 隱形但撐住完整句子的高度，打字／刪除時不推動下方內容 */
  .hh-type {
    display: grid;
  }
  .hh-type-ghost,
  .hh-type-live {
    grid-area: 1 / 1;
  }
  .hh-type-ghost::before {
    content: attr(data-text);
  }
  .hh-type-live {
    visibility: hidden;
  }
  .hh-type.is-typing .hh-type-ghost {
    visibility: hidden;
  }
  .hh-type.is-typing .hh-type-live {
    visibility: visible;
  }
  .hh-cursor {
    margin-left: 2px;
    font-weight: 400;
    animation: hh-blink .5s steps(1) infinite alternate;
  }
  @keyframes hh-blink {
    from { opacity: 1; }
    to { opacity: 0; }
  }
  .hh-intro {
    font-size: 1.1875rem;
    line-height: 1.85;
    color: #33506B;
    max-width: 34em;
    margin: 20px 0 0;
  }
  /* ── 白底版：圖片靠右滿版、底緣貼齊 Hero 底部；3:2（原圖比例，不裁切）；無圓角、無陰影 ── */
  .hh {
    --imgw: min(54vw, 960px);
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: calc(var(--imgw) / 1.5 + 40px);
    overflow: hidden;
  }
  .hh-in {
    display: block;
    width: 100%;
  }
  .hh-txt {
    position: relative;
    z-index: 2;
    max-width: calc(100vw - var(--imgw) - 40px - max(56px, (100vw - 90rem) / 2 + 56px));
  }
  .hh-img {
    position: absolute;
    right: 0;
    bottom: 0;
    z-index: 1;
    width: var(--imgw);
    aspect-ratio: 3 / 2;
    overflow: hidden;
    /* 左緣 8px 羽化：只消除與延伸海浪帶之間的數值接縫 */
    -webkit-mask-image: linear-gradient(to right, transparent 0, #000 8px);
    mask-image: linear-gradient(to right, transparent 0, #000 8px);
  }
  .hh-layer {
    position: absolute;
    inset: 0;
    container-type: size;
  }
  .hh-layer picture {
    display: block;
    width: 100%;
    height: 100%;
  }
  .hh-pic {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: right bottom;
  }
  /* 左欄底部延伸海浪帶：右緣接圖片左緣（多 24 單位墊在羽化底下），與圖片同比例縮放（1 單位＝原圖 1 像素）；靜止 */
  .hh-base {
    position: absolute;
    bottom: 0;
    right: calc(var(--imgw) * 0.984375);
    width: calc(var(--imgw) * 1.015625);
    height: calc(var(--imgw) * 0.121582);
    z-index: 0;
    display: block;
    pointer-events: none;
  }
  /* 動態層：資源與 WebGL 都就緒（.is-live）才淡入，之前只有靜態圖 */
  .hh-fx,
  .hh-birds {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    visibility: hidden;
    transition: opacity .4s ease, visibility 0s linear .4s;
    pointer-events: none;
  }
  .hh-img.is-live .hh-fx,
  .hh-img.is-live .hh-birds {
    opacity: 1;
    visibility: visible;
    transition: opacity .4s ease;
  }
  /* 海鷗：位置以原圖座標百分比定位（與靜態圖共用同一座標），週期 16 秒、起飛錯開 0／5／10 秒 */
  .hh-bird {
    position: absolute;
    left: 0;
    top: 0;
    opacity: 0;
  }
  .hh-bird img {
    display: block;
    width: 100%;
    height: auto;
    animation: hh-bob 2.2s ease-in-out infinite alternate, hh-tilt 3.1s ease-in-out infinite alternate;
  }
  .hh-bird.b2 img { animation-delay: -.7s, -1.1s; }
  .hh-bird.b3 img { animation-delay: -1.4s, -2s; }
  .hh-img.is-live .hh-bird.b1 { animation: hh-fly1 16s linear -6s infinite; }
  .hh-img.is-live .hh-bird.b2 { animation: hh-fly2 16s linear -1s infinite; }
  .hh-img.is-live .hh-bird.b3 { animation: hh-fly3 16s linear -12s infinite; }
  @keyframes hh-tilt { from { rotate: -3.0deg; } to { rotate: 3.0deg; } }
  @keyframes hh-bob { from { translate: 0 -0.391cqh; } to { translate: 0 0.391cqh; } }
  @keyframes hh-fly1 {
    0.00% { left:4.264%; top:12.500%; opacity:0; }
    8.33% { left:11.801%; top:11.677%; opacity:1; }
    16.67% { left:19.437%; top:10.965%; opacity:1; }
    25.00% { left:27.173%; top:10.364%; opacity:1; }
    33.33% { left:35.008%; top:9.874%; opacity:1; }
    41.67% { left:42.943%; top:9.496%; opacity:1; }
    50.00% { left:50.977%; top:9.229%; opacity:1; }
    58.33% { left:59.110%; top:9.073%; opacity:1; }
    66.67% { left:67.343%; top:9.028%; opacity:1; }
    75.00% { left:75.675%; top:9.094%; opacity:1; }
    83.33% { left:84.107%; top:9.272%; opacity:1; }
    91.67% { left:92.639%; top:9.561%; opacity:1; }
    100.00% { left:101.270%; top:9.961%; opacity:0; }
  }
  @keyframes hh-fly2 {
    0.00% { left:4.980%; top:20.752%; opacity:0; }
    8.33% { left:10.130%; top:19.458%; opacity:1; }
    16.67% { left:15.813%; top:18.245%; opacity:1; }
    25.00% { left:22.030%; top:17.114%; opacity:1; }
    33.33% { left:28.780%; top:16.064%; opacity:1; }
    41.67% { left:36.063%; top:15.096%; opacity:1; }
    50.00% { left:43.880%; top:14.209%; opacity:1; }
    58.33% { left:52.231%; top:13.403%; opacity:1; }
    66.67% { left:61.115%; top:12.679%; opacity:1; }
    75.00% { left:70.532%; top:12.036%; opacity:1; }
    83.33% { left:80.483%; top:11.475%; opacity:1; }
    91.67% { left:90.968%; top:10.994%; opacity:1; }
    100.00% { left:101.986%; top:10.596%; opacity:0; }
  }
  @keyframes hh-fly3 {
    0.00% { left:101.497%; top:9.570%; opacity:0; }
    8.33% { left:93.066%; top:9.498%; opacity:1; }
    16.67% { left:84.697%; top:9.608%; opacity:1; }
    25.00% { left:76.392%; top:9.900%; opacity:1; }
    33.33% { left:68.150%; top:10.373%; opacity:1; }
    41.67% { left:59.971%; top:11.028%; opacity:1; }
    50.00% { left:51.855%; top:11.865%; opacity:1; }
    58.33% { left:43.803%; top:12.884%; opacity:1; }
    66.67% { left:35.815%; top:14.084%; opacity:1; }
    75.00% { left:27.889%; top:15.466%; opacity:1; }
    83.33% { left:20.027%; top:17.030%; opacity:1; }
    91.67% { left:12.228%; top:18.776%; opacity:1; }
    100.00% { left:4.492%; top:20.703%; opacity:0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hh-fx,
    .hh-birds { display: none; }
  }
  @media (max-width: 900px) {
    .hh {
      display: block;
      padding: 32px 24px 0;
      min-height: 0;
    }
    .hh-in {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
    }
    .hh-h1 {
      font-size: 2.125rem;
    }
    .hh-intro {
      font-size: 1.0625rem;
    }
    .hh-txt {
      max-width: none;
    }
    /* 手機：圖在文字下方，左右滿版貼齊視窗、底緣貼齊 Hero 底部；不做任何左緣淡出或遮罩；不顯示延伸海浪帶 */
    .hh-img {
      position: relative;
      right: auto;
      bottom: auto;
      width: auto;
      margin: 32px -24px 0;
      -webkit-mask-image: none;
      mask-image: none;
    }
    .hh-base {
      display: none;
    }
  }
</style>
