---
/**
 * 首頁兩欄 Hero：左欄文字與按鈕、右欄圓角圖片。
 * 圖片目前是紙雕橫幅（hero-banner）的裁切放樣圖，之後會換成新圖。
 * 按鈕連結由 brand-nav.ts 產生，不寫死網址。
 */
import {
  brandCategoryHref,
  brandSectionHref,
  getBrandSection,
  getNavBrandMenus,
  getVisibleCategories,
} from '../data/brand-nav';
import { getAllPosts } from '../lib/notion';

// ── 文字（集中在這裡，方便修改）──────────────────────────────
const EYEBROW = '郵輪旅人 · CRUISE TRAVELER';
const TITLE = '陪你準備每一趟郵輪旅程';
// 標語打字效果（參照 React Bits TextType 預設值）
const TYPING_SPEED = 90;
const DELETING_SPEED = 40;
const PAUSE_DURATION = 2000;
const INTRO =
  '有感於中文郵輪資訊的稀缺，「郵輪旅人」是第一個以郵輪研究為主題的中文網站，分享國內外論壇與部落格的郵輪知識與心得資訊。';
const PRIMARY_LABEL = '新手入門';
const SECONDARY_LABEL = '最新資訊';
// ─────────────────────────────────────────────────────────

const allPosts = await getAllPosts();
const guide = getBrandSection('guide');
const newbie = getVisibleCategories(guide, allPosts).find((c) => c.slug === 'newbie');
const primaryHref = newbie ? brandCategoryHref(guide, newbie) : brandSectionHref(guide);
/** 最新資訊分區目前不可見（所有分類都沒有文章）時為 undefined，不渲染次按鈕 */
const secondaryHref = getNavBrandMenus(allPosts).find((m) => m.section.key === 'news')?.href;
---

<section class="hh">
  <div class="hh-in">
    <div class="hh-txt">
      <div class="ovl">{EYEBROW}</div>
      <h1 class="hh-h1 srf">
        <span class="hh-sr">{TITLE}</span>
        <span
          class="hh-type"
          aria-hidden="true"
          data-typing={TYPING_SPEED}
          data-deleting={DELETING_SPEED}
          data-pause={PAUSE_DURATION}
        >
          <span class="hh-type-ghost" data-text={TITLE}></span>
          <span class="hh-type-live"><span class="hh-type-t"></span><span class="hh-cursor">|</span></span>
        </span>
      </h1>
      <script is:inline>
        // 打字效果：無 JS 或偏好減少動態時不執行，直接顯示完整句子（.hh-type-ghost 的 ::before）
        (function () {
          var h1 = document.currentScript.previousElementSibling;
          var root = h1 && h1.querySelector('.hh-type');
          if (!root) return;
          if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
          var full = Array.from(root.querySelector('.hh-type-ghost').getAttribute('data-text'));
          var out = root.querySelector('.hh-type-t');
          var typing = Number(root.dataset.typing);
          var deleting = Number(root.dataset.deleting);
          var pause = Number(root.dataset.pause);
          var n = 0;
          var erasing = false;
          root.classList.add('is-typing');
          function tick() {
            var wait;
            if (!erasing) {
              n += 1;
              out.textContent = full.slice(0, n).join('');
              if (n === full.length) { erasing = true; wait = pause; } else { wait = typing; }
            } else {
              n -= 1;
              out.textContent = full.slice(0, n).join('');
              if (n === 0) { erasing = false; wait = 400; } else { wait = deleting; }
            }
            setTimeout(tick, wait);
          }
          setTimeout(tick, typing);
        })();
      </script>
      <p class="hh-intro">{INTRO}</p>
      <div class="hh-btns">
        <a class="hh-btn hh-btn-p" href={primaryHref}>{PRIMARY_LABEL}</a>
        {secondaryHref && <a class="hh-btn hh-btn-s" href={secondaryHref}>{SECONDARY_LABEL}</a>}
      </div>
    </div>
    <div class="hh-img">
      <picture>
        <source
          srcset="/assets/hero-banner-640.webp 640w, /assets/hero-banner-960.webp 960w, /assets/hero-banner-1280.webp 1280w, /assets/hero-banner.webp 1536w, /assets/hero-banner-1920.webp 1920w"
          sizes="(min-width: 901px) 48vw, calc(100vw - 48px)"
          type="image/webp"
        />
        <img
          class="hh-pic"
          src="/assets/hero-banner.png"
          alt="郵輪旅人 Royal Cruiser——紙雕風格插畫，皇家加勒比郵輪航行於海灣與熱帶島嶼之間，標語：上船那一刻起，假期才真正開始"
          width="1536"
          height="464"
          loading="eager"
          decoding="async"
          fetchpriority="high"
          data-lcp
        />
      </picture>
    </div>
  </div>
</section>

<style>
  .hh {
    background: #fff;
    color: #0B2A4A;
    padding: 56px 56px 48px;
    box-sizing: border-box;
  }
  .hh-in {
    max-width: 90rem;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 52fr) minmax(0, 48fr);
    gap: 48px;
    align-items: center;
  }
  .hh-txt {
    min-width: 0;
  }
  .hh-h1 {
    font-size: clamp(2.25rem, 3.4vw, 3.25rem);
    line-height: 1.25;
    font-weight: 900;
    letter-spacing: .01em;
    margin: 14px 0 0;
    color: #0B2A4A;
    overflow-wrap: anywhere;
  }
  .hh-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  /* 打字效果：ghost 與 live 疊在同一格，ghost 隱形但撐住完整句子的高度，打字／刪除時不推動下方內容 */
  .hh-type {
    display: grid;
  }
  .hh-type-ghost,
  .hh-type-live {
    grid-area: 1 / 1;
  }
  .hh-type-ghost::before {
    content: attr(data-text);
  }
  .hh-type-live {
    visibility: hidden;
  }
  .hh-type.is-typing .hh-type-ghost {
    visibility: hidden;
  }
  .hh-type.is-typing .hh-type-live {
    visibility: visible;
  }
  .hh-cursor {
    margin-left: 2px;
    font-weight: 400;
    animation: hh-blink .5s steps(1) infinite alternate;
  }
  @keyframes hh-blink {
    from { opacity: 1; }
    to { opacity: 0; }
  }
  .hh-intro {
    font-size: 1.1875rem;
    line-height: 1.85;
    color: #33506B;
    max-width: 34em;
    margin: 20px 0 0;
  }
  .hh-btns {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }
  .hh-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 28px;
    box-sizing: border-box;
    border-radius: 12px;
    border: 1px solid #0B2A4A;
    font-size: 16px;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }
  .hh-btn-p {
    background: #0B2A4A;
    color: #fff;
  }
  .hh-btn-s {
    background: #fff;
    color: #0B2A4A;
  }
  .hh-btn:hover {
    opacity: .85;
  }
  .hh-img {
    aspect-ratio: 4 / 3;
    border-radius: 16px;
    overflow: hidden;
    background: #F4F9FD;
    box-shadow: 0 14px 40px rgba(11, 42, 74, .14);
  }
  .hh-img picture {
    display: block;
    width: 100%;
    height: 100%;
  }
  .hh-pic {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: right center;
  }
  @media (max-width: 900px) {
    .hh {
      padding: 32px 24px 40px;
    }
    .hh-in {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
    }
    .hh-h1 {
      font-size: 2.125rem;
    }
    .hh-intro {
      font-size: 1.0625rem;
    }
  }
</style>
