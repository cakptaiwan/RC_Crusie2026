---
import SidebarPillForm from './SidebarPillForm.astro';
---

<div class="sidebar-widget">
  <div class="sidebar-section-header">
    <span class="sidebar-section-title">站內搜尋</span>
  </div>
  <div id="search">
    <SidebarPillForm
      action="/search/"
      name="q"
      type="search"
      label="關鍵字"
      placeholder="輸入關鍵字…"
      buttonLabel="搜尋"
      ariaLabel="站內搜尋"
    />
  </div>
</div>

<script is:inline>
  // Pagefind UI 延後載入：第一次互動搜尋框（或頁面載入後閒置）才插入 CSS／JS，只載入一次
  window.rcLoadPagefindUI =
    window.rcLoadPagefindUI ||
    function () {
      if (window.rcPagefindUIPromise) return window.rcPagefindUIPromise;
      const add = (el) =>
        new Promise((resolve, reject) => {
          el.addEventListener('load', resolve, { once: true });
          el.addEventListener('error', reject, { once: true });
          document.head.appendChild(el);
        });
      const css = document.createElement('link');
      css.rel = 'stylesheet';
      css.href = '/pagefind/pagefind-ui.css';
      const js = document.createElement('script');
      js.src = '/pagefind/pagefind-ui.js';
      window.rcPagefindUIPromise = Promise.all([add(css).catch(() => {}), add(js)]);
      return window.rcPagefindUIPromise;
    };

  function initPagefindSearch() {
    if (!window.PagefindUI) return false;
    const root = document.getElementById('search');
    if (!root || root.dataset.pagefindInit === '1') return true;

    // 保留載入前在備用表單輸入的字與焦點
    const fallbackInput = root.querySelector('input');
    const typed = fallbackInput ? fallbackInput.value.trim() : '';
    const hadFocus = !!fallbackInput && document.activeElement === fallbackInput;

    // 清空容器內原本的備用表單（SidebarPillForm），避免兩者同時顯示
    root.innerHTML = '';
    const ui = new window.PagefindUI({
      element: '#search',
      showImages: false,
      translations: {
        placeholder: '輸入關鍵字…',
        zero_results: '找不到相關文章',
        many_results: '找到 [COUNT] 篇與 [SEARCH_TERM] 相關的文章',
        one_result: '找到 1 篇與 [SEARCH_TERM] 相關的文章',
        clear_search: '清除',
      },
    });
    root.dataset.pagefindInit = '1';
    const input = root.querySelector('.pagefind-ui__search-input');
    if (input && hadFocus) input.focus();
    if (typed) ui.triggerSearch(typed);
    return true;
  }

  function bootPagefindSearch() {
    if (initPagefindSearch()) return;
    const root = document.getElementById('search');
    if (!root || root.dataset.pagefindBound === '1') return;
    root.dataset.pagefindBound = '1';

    let started = false;
    const start = () => {
      if (started) return;
      started = true;
      window.rcLoadPagefindUI().then(initPagefindSearch, () => {
        /* Pagefind 未部署或 dev 環境：保留 GET /search 表單 */
      });
    };
    ['focusin', 'pointerenter', 'touchstart'].forEach((type) =>
      root.addEventListener(type, start, { once: true, passive: true })
    );
    const idle = () =>
      'requestIdleCallback' in window ? requestIdleCallback(start, { timeout: 3000 }) : setTimeout(start, 1500);
    if (document.readyState === 'complete') idle();
    else window.addEventListener('load', idle, { once: true });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', bootPagefindSearch);
  } else {
    bootPagefindSearch();
  }
</script>

<style is:global>
  /* Pagefind 側欄搜尋框 — 對齊皇家旅人 pill 樣式 */
  #search .pagefind-ui {
    width: 100%;
  }
  #search .pagefind-ui__form {
    width: 100%;
  }
  #search .pagefind-ui__search-input {
    display: block;
    width: 100%;
    border-radius: 9999px;
    border: 1px solid rgb(0 115 187 / 0.35);
    background: #fff;
    padding: 0.625rem 1rem;
    font-size: 14px;
    color: #1e2937;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.05);
    outline: none;
  }
  #search .pagefind-ui__search-input::placeholder {
    color: rgb(100 116 139 / 0.7);
  }
  #search .pagefind-ui__search-input:focus {
    border-color: #0073bb;
  }
</style>
