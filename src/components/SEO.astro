---
import { socialLinks } from '../data/social-links';

export interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  jsonLd?: Record<string, unknown>;
  noindex?: boolean;
  breadcrumb?: Array<{ name: string; url: string }>;
}
const { title, description, image = 'https://royal-cruiser.com/assets/og-default.jpg', type = 'website', jsonLd, noindex = false, breadcrumb } = Astro.props;
const breadcrumbJsonLd = breadcrumb ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumb.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.name,
    item: item.url,
  })),
} : null;
const siteUrl = 'https://royal-cruiser.com';
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
const baseJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Royal Cruiser 皇家旅人',
  url: siteUrl,
  logo: `${siteUrl}/logo.png`,
  description: '專業郵輪旅遊心得，提供真實體驗與實用攻略',
  contactPoint: { '@type': 'ContactPoint', contactType: 'customer service', availableLanguage: ['Chinese', 'English'] },
  sameAs: socialLinks.map((link) => link.href),
};
const mergedJsonLd = jsonLd ?? baseJsonLd;
---
<title>{title} | Royal Cruiser 皇家旅人</title>
{noindex && <meta name="robots" content="noindex, follow" />}
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={image} />
<meta property="og:type" content={type} />
<meta property="og:site_name" content="Royal Cruiser 皇家旅人" />
<meta property="og:locale" content="zh_TW" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
<script type="application/ld+json" set:html={JSON.stringify(mergedJsonLd)} />
{breadcrumbJsonLd && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />}
