---
import { buildOrganizationJsonLd, buildWebSiteJsonLd, jsonLdScriptContent } from '../lib/seo/jsonld';
import { absoluteSiteUrl, defaultOgImage } from '../lib/seo/site-url';

export interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  jsonLd?: Record<string, unknown>;
  noindex?: boolean;
  breadcrumb?: Array<{ name: string; url: string }>;
}
const {
  title,
  description,
  image = defaultOgImage,
  type = 'website',
  jsonLd,
  noindex = false,
  breadcrumb,
} = Astro.props;
const breadcrumbJsonLd = breadcrumb
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: breadcrumb.map((item, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: item.name,
        item: item.url,
      })),
    }
  : null;
const siteUrl = 'https://royal-cruiser.com';
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
const organizationJsonLd = buildOrganizationJsonLd();
const websiteJsonLd = Astro.url.pathname === '/' ? buildWebSiteJsonLd() : null;
const ogImage = image.startsWith('http') ? image : absoluteSiteUrl(image.startsWith('/') ? image : `/${image}`);
---
<title>{title} | Royal Cruiser 皇家旅人</title>
{noindex && <meta name="robots" content="noindex, follow" />}
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={ogImage} />
<meta property="og:type" content={type} />
<meta property="og:site_name" content="Royal Cruiser 皇家旅人" />
<meta property="og:locale" content="zh_TW" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<script type="application/ld+json" set:html={jsonLdScriptContent(organizationJsonLd)} />
{websiteJsonLd && (
  <script type="application/ld+json" set:html={jsonLdScriptContent(websiteJsonLd)} />
)}
{jsonLd && (
  <script type="application/ld+json" set:html={jsonLdScriptContent(jsonLd)} />
)}
{breadcrumbJsonLd && (
  <script type="application/ld+json" set:html={jsonLdScriptContent(breadcrumbJsonLd)} />
)}
