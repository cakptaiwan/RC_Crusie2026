---
/** 分區右欄清單卡（最新文章／更多文章／延伸閱讀）；0 篇時不渲染 */
import { newArticleUrl } from '../../lib/new-article-url';
import type { Post } from '../../lib/notion';

interface Props {
  title: string;
  posts: Pick<Post, 'id' | 'title' | 'date'>[];
}

const { title, posts } = Astro.props;
const formatDate = (date: string) => (date ? date.slice(0, 10) : '');
---

{
  posts.length > 0 && (
    <section class="bs3-card bsl-card">
      <h2 class="bs3-card-h bsl-h">{title}</h2>
      <ul class="bsl">
        {posts.map((post) => (
          <li>
            <a class="bsl-a" href={newArticleUrl(post.id)} title={post.title}>
              <span class="bsl-t">{post.title}</span>
              <span class="a-date">{formatDate(post.date)}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  /* 卡片內距、邊框、圓角沿用 .bs3-card（變數）；標題無底色，16px／700，下方 1px 細線 */
  .bsl-h {
    margin: 0;
    padding: 0 0 10px;
    border-bottom: 1px solid var(--card-border);
    color: #0B2A4A;
    font-size: 16px;
    font-weight: 700;
    line-height: 1.4;
  }
  .bsl {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .bsl li + li {
    border-top: 1px solid rgba(11, 42, 74, .1);
  }
  .bsl-a {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 10px 0;
    text-decoration: none;
  }
  /* 標題最多 2 行（完整標題仍在 DOM，並放在 title 屬性） */
  .bsl-t {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-size: 14.5px;
    font-weight: 600;
    line-height: 1.5;
    color: #0B2A4A;
    overflow-wrap: anywhere;
  }
  .bsl-a .a-date {
    font-size: 12px;
    color: var(--text-muted);
  }
</style>
