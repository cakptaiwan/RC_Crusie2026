---
/** 分區左欄：品牌簡介卡（文章數、分類數、簡介）＋分類清單（目前分類選中） */
import { brandCategoryHref, type BrandSection, type VisibleBrandCategory } from '../../data/brand-nav';

interface Props {
  section: BrandSection;
  intro: string;
  postCount: number;
  categories: VisibleBrandCategory[];
  activeSlug?: string;
}

const { section, intro, postCount, categories, activeSlug } = Astro.props;
---

<div class="bs3-card bsi-intro-card">
  <div class="ovl">Section · {section.slug}</div>
  <div class="bs3-card-h" style="margin:8px 0 10px;font-size:20px">{section.label}</div>
  <div class="bsi-stats">
    <span><b>{postCount}</b> 篇文章</span>
    <span><b>{categories.length}</b> 個分類</span>
  </div>
  <p class="bsi-intro">{intro}</p>
</div>
{
  categories.length > 0 && (
    <nav class="bs3-card" aria-label={`${section.label}分類`}>
      <div class="bs3-card-h bsi-nav-h">分類</div>
      <ul class="bsi-list">
        {categories.map((category) => (
          <li>
            <a
              href={brandCategoryHref(section, category)}
              class:list={['bsi-item', category.slug === activeSlug && 'bsi-on']}
              aria-current={category.slug === activeSlug ? 'page' : undefined}
            >
              <span>{category.label}</span>
              <span class="bsi-n">{category.count}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<style>
  /* 手機（≤900px）隱藏簡介卡：頁首卡內改顯示統計一行（BrandSectionIndex 的 .sec-stats-m），桌機維持顯示 */
  @media (max-width: 900px) {
    .bsi-intro-card {
      display: none;
    }
  }
  /* 分類卡標題：16px／700，下方 1px 細線 */
  .bsi-nav-h {
    margin: 0 0 8px;
    padding: 0 0 10px;
    border-bottom: 1px solid var(--card-border);
    font-size: 16px;
    font-weight: 700;
    line-height: 1.4;
  }
  .bsi-stats {
    display: flex;
    gap: 16px;
    font-size: 13px;
    color: #51677C;
  }
  .bsi-stats b {
    color: #0B2A4A;
    font-size: 16px;
  }
  .bsi-intro {
    margin: 12px 0 0;
    font-size: 14px;
    line-height: 1.8;
    color: #51677C;
  }
  .bsi-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .bsi-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 7px 10px;
    border-radius: 8px;
    font-size: 14.5px;
    color: #33506B;
    text-decoration: none;
  }
  .bsi-item:hover {
    background: rgba(11, 42, 74, .04);
    opacity: 1;
  }
  .bsi-n {
    font-size: 12px;
    color: var(--text-muted);
  }
  .bsi-on {
    background: #EAF3FA;
    color: #0B2A4A;
    font-weight: 700;
  }
  .bsi-on .bsi-n {
    color: #3E6C97;
  }
</style>
