---
/** 品牌分區首頁（三欄）：左欄簡介與分類、中欄頁首卡＋頁籤＋最新 6 篇、右欄更多文章與延伸閱讀 */
import NewLayout from '../../layouts/NewLayout.astro';
import BrandThreeCol from './BrandThreeCol.astro';
import BrandSideIntro from './BrandSideIntro.astro';
import BrandSideList from './BrandSideList.astro';
import BrandTabs from './BrandTabs.astro';
import BrandPostCard from './BrandPostCard.astro';
import { furtherReadingPosts } from './side-posts';
import {
  BRAND_SECTIONS_INDEXABLE,
  brandSectionHref,
  getSectionPosts,
  getVisibleCategories,
  type BrandSection,
} from '../../data/brand-nav';
import { brandSectionIntros, brandSectionLongIntros } from '../../data/brand-category-intros';
import { getAllPosts } from '../../lib/notion';
import { newHomeUrl } from '../../lib/new-article-url';
import { absoluteSiteUrl } from '../../lib/seo/site-url';
import { buildCollectionPageJsonLd } from '../../lib/seo/jsonld';
import { categoryMetaDescription } from '../../data/category-intros';

interface Props {
  section: BrandSection;
}

const { section } = Astro.props;
const allPosts = await getAllPosts();
const categories = getVisibleCategories(section, allPosts);
/** 完整分區文章（文章數由此計算）；中欄取最新 6 篇，右欄「更多文章」為第 7–11 篇 */
const sectionPosts = getSectionPosts(section, allPosts);
const latestPosts = sectionPosts.slice(0, 6);
const morePosts = sectionPosts.slice(6, 11);
const furtherPosts = furtherReadingPosts(section, allPosts, [...latestPosts, ...morePosts]);

const intro = brandSectionIntros[section.key];
if (!intro) {
  throw new Error(`brand-category-intros.ts 缺少分區簡介：${section.key}`);
}
const pageDescription = categoryMetaDescription(intro);
/** 頁面可見導言：有長版（公主旅人、最新資訊）顯示長版，其餘沿用一句；meta 與左欄簡介卡不受影響 */
const visibleIntro = brandSectionLongIntros[section.key] ?? intro;
const pageUrl = absoluteSiteUrl(brandSectionHref(section));
const collectionPageJsonLd = buildCollectionPageJsonLd(section.label, pageDescription, pageUrl);

const breadcrumbJsonLdItems = [
  { name: '首頁', url: absoluteSiteUrl('/') },
  { name: section.label, url: pageUrl },
];

/** 品牌首頁標題下方的小字英文（純裝飾，不放進 h1）；參照頁首 .wm-stack／.wm2 的風格 */
const brandEnglishTitles: Record<string, string> = { royal: 'Royal Caribbean', princess: 'Princess Cruises' };
---

<NewLayout
  title={section.label}
  description={pageDescription}
  noindex={!BRAND_SECTIONS_INDEXABLE}
  breadcrumb={breadcrumbJsonLdItems}
  jsonLd={collectionPageJsonLd}
>
  <div class="crumb">
    <a href={newHomeUrl}>首頁</a><span>/</span><span>{section.label}</span>
  </div>
  <BrandThreeCol>
    <div class="bs3-card">
      <div class="ovl">Section · {section.slug}</div>
      {
        section.key === 'royal' || section.key === 'princess' ? (
          <div class="sec-h1-row">
            <img
              class="sec-mark"
              src={`/assets/brand/${section.key}-mark-sq.webp`}
              srcset={`/assets/brand/${section.key}-mark-sq.webp 1x, /assets/brand/${section.key}-mark-sq-2x.webp 2x`}
              alt=""
              aria-hidden="true"
              width="192"
              height="192"
              loading="eager"
              decoding="async"
            />
            <div class="sec-title-stack">
              <h1 class="a-h2 srf">{section.label}</h1>
              <span class="sec-title-en srf" aria-hidden="true">{brandEnglishTitles[section.key]}</span>
            </div>
          </div>
        ) : (
          <h1 class="a-h2 srf">{section.label}</h1>
        )
      }
      <p class="a-ex" style="margin:12px 0 0">{visibleIntro}</p>
      <div class="sec-stats-m">
        <span><b>{sectionPosts.length}</b> 篇文章</span>
        <span><b>{categories.length}</b> 個分類</span>
      </div>
    </div>
    <BrandTabs section={section} categories={categories} />
    {latestPosts.map((post, index) => <BrandPostCard post={post} eager={index === 0} />)}
    {
      latestPosts.length === 0 && (
        <p class="a-ex" style="margin-top:24px">尚無文章，敬請期待。</p>
      )
    }
    <Fragment slot="right">
      <BrandSideList title="更多文章" posts={morePosts} />
      <BrandSideList title="延伸閱讀" posts={furtherPosts} />
    </Fragment>
    <BrandSideIntro slot="left" section={section} intro={intro} postCount={sectionPosts.length} categories={categories} />
  </BrandThreeCol>
</NewLayout>

<style>
  /* 統計一行：只在 ≤900px 顯示（桌機左欄簡介卡已有）；樣式沿用簡介卡統計（.bsi-stats） */
  .sec-stats-m {
    display: none;
    gap: 16px;
    margin-top: 12px;
    font-size: 13px;
    color: #51677C;
  }
  .sec-stats-m b {
    color: #0B2A4A;
    font-size: 16px;
  }
  @media (max-width: 900px) {
    .sec-stats-m {
      display: flex;
    }
  }
  /* 標題列＝圖示＋文字堆疊（大標＋小字英文）。圖示邊長由同一組變數算出文字堆疊高度（行高固定為 1.1），
     所以圖示與文字堆疊等高、垂直置中；字級手機 30px、桌機 42px（同 .a-h2），小字英文為大標的 40%，字距 .14em（上限） */
  .sec-h1-row {
    --h1fs: 30px;
    --subfs: calc(var(--h1fs) * 0.4);
    --stack-gap: 2px;
    --stack-h: calc(var(--h1fs) * 1.1 + var(--stack-gap) + var(--subfs) * 1.1);
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 12px;
  }
  @media (min-width: 901px) {
    .sec-h1-row {
      --h1fs: 42px;
    }
  }
  .sec-mark {
    width: var(--stack-h);
    height: var(--stack-h);
    flex-shrink: 0;
    display: block;
  }
  .sec-title-stack {
    display: flex;
    flex-direction: column;
    gap: var(--stack-gap);
    min-width: 0;
  }
  .sec-title-stack h1 {
    margin: 0;
    font-size: var(--h1fs);
    line-height: 1.1;
    min-width: 0;
  }
  .sec-title-en {
    font-size: var(--subfs);
    line-height: 1.1;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.65;
    color: #0B2A4A;
  }
</style>
