---
/** 分區文章卡：左圖右文（縮圖、新分類、標題、日期、摘要），整張卡連到 /post/<id>/ */
import { postImage } from '../../lib/cloudinary-image';
import { newArticleUrl } from '../../lib/new-article-url';
import type { Post } from '../../lib/notion';

interface Props {
  post: Pick<Post, 'id' | 'title' | 'date' | 'image' | 'excerpt' | 'newCategory'>;
  /** 第一張卡為首屏圖，不延遲載入 */
  eager?: boolean;
}

const { post, eager = false } = Astro.props;
const formatDate = (date: string) => (date ? date.slice(0, 10) : '');
---

<a class="bpc" href={newArticleUrl(post.id)}>
  <span class="a-thumb zi bpc-img">
    {
      eager ? (
        <img class="ph" src={postImage(post.image, 'thumb')} alt={post.title} fetchpriority="high" />
      ) : (
        <img class="ph" src={postImage(post.image, 'thumb')} alt={post.title} loading="lazy" />
      )
    }
  </span>
  <span class="bpc-body">
    <span class="fx ac gap12">
      {post.newCategory && <span class="a-cat">{post.newCategory}</span>}
      <span class="a-date">{formatDate(post.date)}</span>
    </span>
    <span class="a-rt srf bpc-t">{post.title}</span>
    {post.excerpt && <span class="bpc-ex">{post.excerpt}</span>}
  </span>
</a>

<style>
  .bpc {
    display: grid;
    grid-template-columns: 132px minmax(0, 1fr);
    gap: 20px;
    align-items: start;
    padding: 20px;
    background: #fff;
    border: 1px solid rgba(11, 42, 74, .16);
    border-radius: 16px;
    text-decoration: none;
    color: inherit;
    transition: background .3s;
  }
  .bpc:hover {
    background: rgba(11, 42, 74, .04);
    opacity: 1;
  }
  .bpc-img {
    display: block;
  }
  .bpc-body {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .bpc-t {
    display: block;
    margin: 6px 0;
  }
  .bpc-ex {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-size: 14px;
    line-height: 1.8;
    color: #51677C;
  }
  @media (max-width: 600px) {
    .bpc {
      grid-template-columns: 104px minmax(0, 1fr);
      gap: 14px;
      padding: 14px;
    }
    .bpc .a-thumb {
      width: 104px;
    }
    .bpc-ex {
      display: none;
    }
  }
</style>
