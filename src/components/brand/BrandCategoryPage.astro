---
/** 品牌分區分類頁（三欄）：左欄簡介與分類、中欄頁首卡＋頁籤＋本分類全部文章、右欄最新文章與延伸閱讀 */
import NewLayout from '../../layouts/NewLayout.astro';
import BrandThreeCol from './BrandThreeCol.astro';
import BrandSideIntro from './BrandSideIntro.astro';
import BrandSideList from './BrandSideList.astro';
import BrandTabs from './BrandTabs.astro';
import BrandPostCard from './BrandPostCard.astro';
import { furtherReadingPosts } from './side-posts';
import {
  BRAND_SECTIONS_INDEXABLE,
  brandCategoryHref,
  brandSectionHref,
  getSectionPosts,
  getVisibleCategories,
  type BrandSection,
  type VisibleBrandCategory,
} from '../../data/brand-nav';
import { brandCategoryIntros, brandSectionIntros } from '../../data/brand-category-intros';
import { getAllPosts } from '../../lib/notion';
import { newHomeUrl } from '../../lib/new-article-url';
import { absoluteSiteUrl } from '../../lib/seo/site-url';
import { buildCollectionPageJsonLd } from '../../lib/seo/jsonld';
import { categoryMetaDescription } from '../../data/category-intros';

interface Props {
  section: BrandSection;
  category: VisibleBrandCategory;
}

const { section, category } = Astro.props;
const posts = category.posts;
const allPosts = await getAllPosts();
const categories = getVisibleCategories(section, allPosts);
/** 完整分區文章（左欄文章數）；右欄「最新文章」排除中欄已列出的本分類文章 */
const sectionPosts = getSectionPosts(section, allPosts);
const shownIds = new Set(posts.map((p) => p.id));
const latestPosts = sectionPosts.filter((p) => !shownIds.has(p.id)).slice(0, 5);
const furtherPosts = furtherReadingPosts(section, allPosts, [...posts, ...latestPosts]);
const sectionIntro = brandSectionIntros[section.key] ?? '';

const intro = brandCategoryIntros[`${section.key}/${category.slug}`];
if (!intro) {
  throw new Error(`brand-category-intros.ts 缺少分類導言：${section.key}/${category.slug}`);
}
const pageDescription = categoryMetaDescription(intro);
const pageUrl = absoluteSiteUrl(brandCategoryHref(section, category));
const collectionPageJsonLd = buildCollectionPageJsonLd(category.label, pageDescription, pageUrl);

/** 首頁/分區/分類，JSON-LD 同步 */
const breadcrumbJsonLdItems = [
  { name: '首頁', url: absoluteSiteUrl('/') },
  { name: section.label, url: absoluteSiteUrl(brandSectionHref(section)) },
  { name: category.label, url: pageUrl },
];
---

<NewLayout
  title={category.label}
  description={pageDescription}
  noindex={!BRAND_SECTIONS_INDEXABLE}
  breadcrumb={breadcrumbJsonLdItems}
  jsonLd={collectionPageJsonLd}
>
  <div class="crumb">
    <a href={newHomeUrl}>首頁</a><span>/</span>
    <a href={brandSectionHref(section)}>{section.label}</a><span>/</span>
    <span>{category.label}</span>
  </div>
  <BrandThreeCol>
    <div class="bs3-card">
      <div class="ovl">Category · {category.slug}</div>
      <h1 class="a-h2 srf">{category.label}</h1>
      <div class="a-date" style="letter-spacing:.18em;margin-top:8px">共 {posts.length} 篇文章</div>
      <p class="a-ex" style="margin:12px 0 0">{intro}</p>
    </div>
    <BrandTabs section={section} categories={categories} activeSlug={category.slug} />
    {posts.map((post, index) => <BrandPostCard post={post} eager={index === 0} />)}
    <Fragment slot="right">
      <BrandSideList title="最新文章" posts={latestPosts} />
      <BrandSideList title="延伸閱讀" posts={furtherPosts} />
    </Fragment>
    <BrandSideIntro
      slot="left"
      section={section}
      intro={sectionIntro}
      postCount={sectionPosts.length}
      categories={categories}
      activeSlug={category.slug}
    />
  </BrandThreeCol>
</NewLayout>
